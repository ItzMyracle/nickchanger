    "client": ["com.nickchanger.NickMod"]
  },
  "mixins": ["nickchanger.mixins.json"],
  "depends": {
    "fabricloader": ">=0.18.1",
    "minecraft": "~1.21.11",
    "java": ">=21",
    "fabric-api": "*"
  }
}
